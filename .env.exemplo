# Copie para .env, no servidor, e preencha. O .env não vai para o Git.

# Domínio já apontado para este servidor. Exemplo: biblioteca.suaescola.edu.br
DOMINIO=

# Conta da coordenação, criada só na primeira subida. A troca de senha é obrigatória no primeiro
# acesso. Depois disso, as duas linhas podem sair daqui. Não use $ na senha: o Compose o interpreta.
ADMIN_EMAIL=
ADMIN_SENHA=

# Opcional: login com o Google. Veja docs/deploy.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: chamadas por minuto à API do aplicativo, por IP. O padrão é 60, e a escola inteira sai
# pelo mesmo IP. Aumente se o aplicativo for usado na rede da escola.
V1_LIMITE_POR_MINUTO=

# Opcional: origens web que podem chamar a API, separadas por vírgula. O padrão libera todas.
CORS_ORIGENS=
